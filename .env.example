# ── Servidor ───────────────────────────────────────────────────────────────
# En Railway se usa PORT, que la plataforma inyecta sola.
PUERTO=8090
# Token Bearer que la plataforma debe enviar (Authorization: Bearer <token>)
SERVIDOR_TOKEN=dev-token-cambiar
# URL con la que la plataforma alcanza a este servidor (se usa para armar el enlace de descarga del resultado)
URL_PUBLICA=http://localhost:8090
# Dónde guarda los trabajos. Ruta CORTA y fuera del repo (el paquete tiene rutas largas y, dentro del repo,
# Claude Code leería el CLAUDE.md del proyecto).
# DATA_DIR=C:\pf-sim

# Tamaño máximo del paquete que se acepta (MB)
# LIMITE_PAQUETE_MB=300

# ── IA ─────────────────────────────────────────────────────────────────────
# claude    = Claude Code (CLI) con tu suscripción Pro
# simulada  = no llama a ninguna IA: devuelve los valores del ejemplo de referencia del paquete (para probar el flujo sin gastar cuota)
# local     = modelo local en Ollama (gratuito; los documentos no salen de la máquina). Ver src/ia/local.js y el bloque «IA local» abajo.
IA=claude

# ── IA local (solo con IA=local) ───────────────────────────────────────────
# OLLAMA_URL=http://localhost:11434
# Modelo de Ollama. gpt-oss:20b ganó el banco de prueba; la alternativa es pf-llenado (Qwen3-30B-A3B, más lento).
# LOCAL_MODELO=gpt-oss:20b
# Contexto en tokens. Las instrucciones de una sección ya ocupan ~17k: menos de 64k no alcanza. En Ollama conviene
# OLLAMA_FLASH_ATTENTION=1 y OLLAMA_KV_CACHE_TYPE=q8_0 (variables del usuario de Windows) para que 64k ocupe la mitad de RAM.
# LOCAL_NUM_CTX=65536
# LOCAL_MAX_TURNOS=30
# LOCAL_TIMEOUT_MIN=30
# Carpeta del paquete de herramientas (documentos con OCR + web). Vacío = el modelo no puede abrir archivos.
# HERRAMIENTAS_LOCAL=C:\Users\anton\Desktop\LLM\herramientas
# LOCAL_WEB=1
# Bloques de instrucciones más grandes que esto (tokens) se citan con su ruta en vez de pegarse enteros.
# LOCAL_MAX_TOKENS_BLOQUE=4000
# Con un modelo local conviene trocear más fino: TABLAS_POR_LLAMADA=1 y MAX_CARACTERES_POR_LLAMADA=30000.

# Ruta del ejecutable de Claude Code si no está en el PATH (claude.exe). Con "claude" a secas se busca en el PATH.
# CLAUDE_BIN=C:\Users\anton\.local\bin\claude.exe
# Argumentos que van antes de los demás (solo para pruebas con un falso, p. ej. CLAUDE_BIN=node y CLAUDE_BIN_ARGS=scripts/claude-falso.js)
# CLAUDE_BIN_ARGS=

# Token de larga duración de tu suscripción (se genera UNA vez con: claude setup-token).
# Opcional: si ya hiciste `claude login` en este equipo no hace falta.
# CLAUDE_CODE_OAUTH_TOKEN=

CLAUDE_MODELO=sonnet
# low | medium | high | max  (vacío = el predeterminado del modelo)
# CLAUDE_ESFUERZO=
# Skill aprendida (COM + mapa FTE-EBR-V03). Vacío = conocimiento-plantillas/ junto al servidor.
# SKILL_APRENDIDO=
CLAUDE_MAX_TURNOS=40
CLAUDE_TIMEOUT_MIN=20

# ── Cómo se trocea el trabajo ───────────────────────────────────────────────
# Tablas que se llenan en una misma llamada a la IA (las muy grandes siempre van solas)
TABLAS_POR_LLAMADA=4
# Reintentos cuando la IA responde algo inválido o falla por red/sobrecarga
REINTENTOS=2
# Trabajos que se procesan a la vez
CONCURRENCIA_TRABAJOS=1

# ── Solo IA=simulada ────────────────────────────────────────────────────────
SIMULADA_DEMORA_MS=400

# ── Retención ───────────────────────────────────────────────────────────────
# Días que se conserva el paquete recibido y el resultado tras terminar (el contrato exige ≤ 7 y ≥ 1)
RETENCION_DIAS=7

# 'excel' (por defecto): el resultado es el Excel llenado; Claude Code lo ve y lo llena con herramientas. 'json': como antes, solo respuesta.json.
# SALIDA=excel
