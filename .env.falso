# Servidor LOCAL con un Claude Code de mentira (scripts/claude-falso.js): sirve para probar la UI del chat sin gastar cuota.
# Arranque: npm run dev:falso     (el token local es solo para esta prueba)
IA=claude
CLAUDE_BIN=node
CLAUDE_BIN_ARGS=scripts/claude-falso.js
PUERTO=8090
SERVIDOR_TOKEN=token-local-de-prueba
FALSO_RITMO_MS=12
