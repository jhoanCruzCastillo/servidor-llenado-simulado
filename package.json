{
  "name": "servidor-llenado-simulado",
  "version": "1.0.0",
  "private": true,
  "description": "Servidor de llenado simulado de Proyecta Fácil: recibe el paquete .zip, llena la ficha con Claude Code (suscripción) y entrega el zip de resultado. Contrato en ../docs/servidor-llenado-externo/",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "verificar:claude": "node --env-file-if-exists=.env scripts/verificar-claude.js",
    "dev:falso": "node --env-file=.env.falso src/index.js",
    "probar": "node --env-file-if-exists=.env scripts/probar.js",
    "probar:fallos": "node scripts/prueba-fallos.js",
    "probar:chat": "node scripts/prueba-chat.js",
    "probar:adjuntos": "node scripts/prueba-adjuntos.js",
    "probar:preguntas": "node scripts/prueba-preguntas.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "adm-zip": "^0.5.16",
    "jsonrepair": "^3.15.0",
    "zod": "^4.6.7"
  }
}
